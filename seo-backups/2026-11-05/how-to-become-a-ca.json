, 31, 31)"}}]}}],"paragraphData":{}},{"type":"PARAGRAPH","id":"5kq884960","nodes":[],"paragraphData":{}}]},{"type":"LIST_ITEM","id":"ik8zu185","nodes":[{"type":"PARAGRAPH","id":"yjam2186","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Final Course:","decorations":[{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}},{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" This is the final stage of the CA course.","decorations":[{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}}]}}],"paragraphData":{}},{"type":"PARAGRAPH","id":"ei2d85128","nodes":[],"paragraphData":{}}]}],"bulletedListData":{"indentation":0}},{"type":"HEADING","id":"nif06189","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Eligibility Criteria","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"style":{},"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"aiuni5459","nodes":[],"style":{},"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"jtc7a191","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"To be eligible for the CA Foundation course, you must have:","decorations":[{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}}]}}],"style":{},"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"xoyxe5543","nodes":[],"style":{},"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"BULLETED_LIST","id":"gn2hz193","nodes":[{"type":"LIST_ITEM","id":"c6kje194","nodes":[{"type":"PARAGRAPH","id":"785yw195","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Passed Class 12th or equivalent examination from a recognized board.","decorations":[{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}}]}}],"paragraphData":{}},{"type":"PARAGRAPH","id":"0jbhq5628","nodes":[],"paragraphData":{}}]},{"type":"LIST_ITEM","id":"9o2ge197","nodes":[{"type":"PARAGRAPH","id":"cdcs9198","nod