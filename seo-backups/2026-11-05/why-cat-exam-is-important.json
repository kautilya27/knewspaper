odes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"BULLETED_LIST","id":"qexyui6rhiwylf3748226","nodes":[{"type":"LIST_ITEM","id":"1pjk7i6rhiwylf3748224","nodes":[{"type":"PARAGRAPH","id":"htn2n8789","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Stay Updated:","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Keep yourself updated with current affairs and business trends.","decorations":[{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]}],"bulletedListData":{"indentation":0}},{"type":"PARAGRAPH","id":"9xaxq22427","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"t1jby8792","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The Road Ahead","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3os8t22883","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"oouut8794","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cracking the CAT exam is undoubtedly challenging, but with dedication, smart study strategies, and perseverance, you can achieve your goal of securing admission to a top business school. Remember, the journey is as important as the destination. The skills and knowledge gained during preparation will benefit you throughout your career.","decorations":[{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"d8fs423128","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","spoiler":{"enabled":false},"textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"HEADING","id":"6kvup8918","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"FAQs","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"xpy3l23425","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"xh1yp8963","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Question: What is the CAT exam?","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"qsquk8967","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Answer: ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The Common Admission Test (CAT) is an entrance exam for admission to India's top management institutes, including the IIMs.","decorations":[{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ofzbf24259","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"swbma8970","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Question: Why is the CAT exam important?","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"baxes8974","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Answer: ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"A good CAT score opens doors to top B-schools, leading to better career opportunities and higher earning potential.","decorations":[{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"jb9ci8976","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"x6cxe8980","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Question: How can I prepare for the CAT exam?","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aq36b8984","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Answer: ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Focus on building fundamentals, practicing regularly, and joining coaching institutes for structured guidance.","decorations":[{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"yx98z24200","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"elfks8987","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Question: How much time is needed to prepare for the CAT?","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"rgb(31, 31, 31)"}},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bj2af8991","nodes":[{"type":"TEXT","i