odes":[],"textData":{"text":"A sister ties a rakhi on her brother's wrist and he pledges protection. An ancient Indian festival with a full ritual.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}}],"tableCellData":{}}]},{"type":"TABLE_ROW","id":"34zks246","nodes":[{"type":"TABLE_CELL","id":"tn52r247","nodes":[{"type":"PARAGRAPH","id":"uzbyi248","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bhai Dooj","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}}],"tableCellData":{}},{"type":"TABLE_CELL","id":"nokpw250","nodes":[{"type":"PARAGRAPH","id":"1149v251","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Two days after Diwali","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}}],"tableCellData":{}},{"type":"TABLE_CELL","id":"ys4x6253","nodes":[{"type":"PARAGRAPH","id":"luh19254","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The other Indian brother and sister festival, marked with a tilak and a shared meal.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}}],"tableCellData":{}}]}],"tableData":{"dimensions":{"colsWidthRatio":[],"rowsHeight":[0,0,0,0,0],"colsMinWidth":[]},"cellPadding":[]}},{"type":"PARAGRAPH","id":"to77u256","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"4vjwg258","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The key distinction: ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Raksha Bandhan and Bhai Dooj are between brothers and sisters. Sisters Day is between sisters.","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"HEADING","id":"bc1dk261","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Wishes and messages for your sister","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":2,"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"HEADING","id":"fq69l263","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Short and warm","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":3,"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"86k02265","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       Happy Sisters Day to the one person who has known every version of me.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"1b6yy267","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       You were my first friend and you are still my best one. Happy Sisters Day.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"beupw269","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       Thank you for taking my side even when I was wrong. Happy Sisters Day.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"f3n2n271","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       Nobody makes me laugh like you do. Happy Sisters Day.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"HEADING","id":"280we273","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"For a sister who lives far away","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":3,"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"rlz8l275","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       Different cities, same bond. Missing you today. Happy Sisters Day.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"3dium277","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       Distance has not changed a thing between us. Happy Sisters Day.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"tk607279","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       Wishing I could annoy you in person today. Happy Sisters Day.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"HEADING","id":"x7a1o281","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"For an older sister","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":3,"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"djfz6283","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       You went first at everything so I would know how. Thank you for that.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAli