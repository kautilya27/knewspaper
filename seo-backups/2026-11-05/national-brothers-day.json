"cellPadding":[]}},{"type":"PARAGRAPH","id":"ix2d1119","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"usn45121","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The simplest way to keep them apart: ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Brothers Day is brother to brother. Raksha Bandhan and Bhai Dooj are brother and sister.","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"HEADING","id":"derq0124","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Wishes and messages for your brother","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":2,"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"HEADING","id":"cl15x126","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Short and direct","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":3,"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"gd2ss128","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       Happy Brothers Day to the one who has covered for me more times than either of us will admit.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"fb07f130","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       First rival, permanent teammate. Happy Brothers Day.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"reli7132","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       Thanks for the arguments and everything after them. Happy Brothers Day.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"fskwq134","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       You are the one call I know will always be picked up. Happy Brothers Day.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"HEADING","id":"5j5lr136","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"For an older brother","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":3,"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"soetv138","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       You cleared the path and then pretended it was easy. Thank you.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"q757o140","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       Everything I figured out early, I figured out because you went first.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"HEADING","id":"fc92p142","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"For a younger brother","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":3,"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"klln4144","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       You have overtaken me in more ways than I want to list. Proud of you.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"zrd9h146","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       Still the kid I taught to ride a bike, still the person I go to for advice.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"HEADING","id":"12pwy148","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"For a brother who lives away","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":3,"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"c23n6150","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       Different time zones, same brother. Happy Brothers Day.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"b07jh152","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       The distance is the only thing about this that I would change.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"HEADING","id":"qbn9l154","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"For a friend who is like a brother","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"headingData":{"level":3,"textStyle":{"textAlignment":"JUSTIFY","lineHeight":"1.5"}}},{"type":"PARAGRAPH","id":"inhgb156","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"•       Not blood, still family. Happy Brothers Day.","decorations":[]}}],"style":{"paddingTop":"0px","paddingBottom":"10px"},"paragraphData":{"textStyle":{"textAlignment":"