extData":{"text":" Visible improvements in just one or two appointments.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":"rgb(0, 0, 0)"}}]}}],"style":{},"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}}]},{"type":"LIST_ITEM","id":"bj7cf630","nodes":[{"type":"PARAGRAPH","id":"cg8bn631","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Customized Care:","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"background":"transparent","foreground":"rgb(0, 0, 0)"}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Treatments are tailored to your needs, sensitivity levels, and natural tooth color.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":"rgb(0, 0, 0)"}}]}}],"style":{},"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}}]}],"bulletedListData":{"indentation":0}},{"type":"PARAGRAPH","id":"s431t3455","nodes":[],"style":{},"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"HEADING","id":"rm98y633","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Tips to Maintain Your Whiter Smile Longer","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"background":"transparent","foreground":"rgb(0, 0, 0)"}}]}}],"style":{},"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"520r23790","nodes":[],"style":{},"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"BULLETED_LIST","id":"dffwo635","nodes":[{"type":"LIST_ITEM","id":"ksrir636","nodes":[{"type":"PARAGRAPH","id":"xp4o3637","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Avoid staining foods/drinks (like coffee, red wine) for 48 hours after treatment","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":"rgb(0, 0, 0)"}}]}}],"style":{},"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}}]},{"type":"LIST_ITEM","id":"hizhg639","nodes":[{"type":"PARA