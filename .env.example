# Copy to .env for local development. Nothing here is secret.
# Never add a Wix API key or OAuth client secret to this project:
# everything in it ships to the browser.

# Public OAuth Client ID of your Wix Headless client (Knewspaper Headless Frontend)
WIX_CLIENT_ID=bec8c3a5-50c2-499e-b67a-47b6302bf52b

# Where the dev server runs. Must match a redirect URI allowed in Wix
# for sign-in to work locally: http://localhost:5173/callback/
SITE_ORIGIN=http://localhost:5173
BASE_PATH=/

# Optional: Wix Forms used by the newsletter and contact sections
WIX_NEWSLETTER_FORM_ID=
WIX_CONTACT_FORM_ID=

# Optional: domain Google should index (default: the deployed URL)
# CANONICAL_BASE=https://www.knewspaper.in/
# ALLOW_INDEXING=true
